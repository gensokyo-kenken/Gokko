{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Caddy の後ろで動かすので、自分のPCの中（127.0.0.1）だけで待ち受ける
  "Urls": "http://127.0.0.1:5000",

  "Gokko": {
    // 合言葉と管理キーは、ここに書かずに環境変数（Gokko__Password / Gokko__AdminKey）で渡すのがおすすめ
    "Password": "",
    "AdminKey": "",
    "DataDirectory": "Data",
    "BroadcastIntervalMs": 500,

    "Random": {
      "Enabled": false,
      "RollIntervalSeconds": 47,
      "Probability": 0.1,
      "AutoReleaseSeconds": 360,
      "MaxConcurrent": 1,
      "AvoidRepeat": true,
      "SectionsAhead": 1,
      "SectionsBehind": 0,
      "FallbackToAllCrossings": false
    },

    // 乗務員の Discord ログイン（スコープは identify だけ）。4つそろうと使える。
    // ClientSecret と IdKey は秘密なので、ここには書かずに環境変数（Gokko__Discord__ClientSecret / Gokko__Discord__IdKey。本番は /etc/gokko.env）で渡す
    // RedirectUri は Discord の Developer Portal の Redirects に登録したものと同じにする（https://サーバー/api/auth/discord/callback）
    // PasswordUntil を過ぎると、社員番号とパスワードではログインできない（例: "2026-11-27T00:00:00+09:00"。空なら期限なし）
    "Discord": {
      "ClientId": "",
      "RedirectUri": "",
      "PasswordUntil": null
    }
  }
}
